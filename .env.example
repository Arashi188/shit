NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/serein_dev?schema=public
# Replace this local-only example with a unique random value of at least 32 characters.
AGE_GATE_SECRET=local-development-only-replace-this-secret-before-sharing
# Optional. Set only after choosing the store currency; enables development catalog fixtures.
CATALOG_SEED_CURRENCY=
CATALOG_SEED_CURRENCY_EXPONENT=
# Payment and mail provider configuration for production and staging environments.
PAYMENT_PROVIDER=mock
MAILER_PROVIDER=console
MAILER_FROM=no-reply@example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
# Optional Cloudinary credentials. Keep the API secret server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=serein/catalog
