generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  email           String      @unique @db.VarChar(320)
  displayName     String      @map("display_name") @db.VarChar(120)
  passwordHash    String      @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime?   @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(6)
  sessions        Session[]
  roleAssignments UserRole[]
  passwordResets  PasswordReset[]
  emailVerifications EmailVerification[]
  carts Cart[]
  orders Order[]

  @@index([deletedAt])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_resets")
}

model EmailVerification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("email_verifications")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(60)
  name        String           @db.VarChar(100)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignments UserRole[]
  grants      RolePermission[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique @db.VarChar(100)
  name      String           @db.VarChar(120)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  grants    RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  products  Product[]

  @@index([deletedAt])
  @@map("brands")
}

model Currency {
  code               String    @id @db.Char(3)
  minorUnitExponent Int       @map("minor_unit_exponent")
  isEnabled          Boolean   @default(false) @map("is_enabled")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products           Product[]
  shippingMethods ShippingMethod[]
  coupons Coupon[]

  @@map("currencies")
}

model Category {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @db.VarChar(120)
  slug         String            @unique @db.VarChar(140)
  description  String?           @db.VarChar(500)
  imageUrl     String?           @map("image_url") @db.Text
  imagePublicId String?          @map("image_public_id") @db.VarChar(255)
  parentId     String?           @map("parent_id") @db.Uuid
  sortOrder    Int               @default(0) @map("sort_order")
  isVisible    Boolean           @default(true) @map("is_visible")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(6)
  parent       Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]        @relation("CategoryTree")
  products     ProductCategory[]

  @@index([parentId, sortOrder])
  @@index([isVisible, deletedAt])
  @@map("categories")
}

model Product {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(180)
  slug            String            @unique @db.VarChar(200)
  shortDescription String?           @map("short_description") @db.VarChar(360)
  description     String            @db.Text
  brandId         String?           @map("brand_id") @db.Uuid
  priceMinor      Int               @map("price_minor")
  compareAtMinor  Int?              @map("compare_at_minor")
  currencyCode    String            @map("currency_code") @db.Char(3)
  stockQuantity   Int               @default(0) @map("stock_quantity")
  sortOrder       Int               @default(0) @map("sort_order")
  isFeatured      Boolean           @default(false) @map("is_featured")
  isPublished     Boolean           @default(false) @map("is_published")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)
  brand           Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  currency         Currency          @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  categories      ProductCategory[]
  images          ProductImage[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([isPublished, deletedAt, sortOrder])
  @@index([brandId])
  @@index([currencyCode, priceMinor])
  @@index([createdAt])
  @@map("products")
}

model ProductCategory {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId, sortOrder])
  @@map("product_categories")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  secureUrl   String   @map("secure_url") @db.Text
  publicId    String   @map("public_id") @db.VarChar(255)
  altText     String   @map("alt_text") @db.VarChar(180)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Cart {
  id String @id @default(uuid()) @db.Uuid
  userId String? @unique @map("user_id") @db.Uuid
  guestTokenHash String? @unique @map("guest_token_hash") @db.Char(64)
  couponCode String? @map("coupon_code") @db.VarChar(40)
  shippingMethodId String? @map("shipping_method_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  @@map("carts")
}

model CartItem {
  id String @id @default(uuid()) @db.Uuid
  cartId String @map("cart_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  guestTokenHash String? @unique @map("guest_token_hash") @db.Char(64)
  status String @default("pending") @db.VarChar(30)
  currencyCode String @map("currency_code") @db.Char(3)
  subtotalMinor Int @default(0) @map("subtotal_minor")
  discountMinor Int @default(0) @map("discount_minor")
  shippingMinor Int @default(0) @map("shipping_minor")
  totalMinor Int @default(0) @map("total_minor")
  couponCode String? @map("coupon_code") @db.VarChar(40)
  shippingMethodId String? @map("shipping_method_id") @db.Uuid
  paymentReference String? @map("payment_reference") @db.VarChar(100)
  paymentStatus String? @map("payment_status") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  name String @db.VarChar(180)
  slug String @db.VarChar(200)
  priceMinor Int @map("price_minor")
  currencyCode String @map("currency_code") @db.Char(3)
  quantity Int
  imageUrl String? @map("image_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model Coupon {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  percentOff Int? @map("percent_off")
  amountOffMinor Int? @map("amount_off_minor")
  currencyCode String? @map("currency_code") @db.Char(3)
  minimumSubtotalMinor Int @default(0) @map("minimum_subtotal_minor")
  usageLimit Int? @map("usage_limit")
  usedCount Int @default(0) @map("used_count")
  startsAt DateTime? @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  isEnabled Boolean @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  currency Currency? @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  @@index([isEnabled, startsAt, expiresAt])
  @@map("coupons")
}

model ShippingMethod {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  countryCode String? @map("country_code") @db.Char(2)
  currencyCode String @map("currency_code") @db.Char(3)
  feeMinor Int @map("fee_minor")
  estimatedDaysMin Int @map("estimated_days_min")
  estimatedDaysMax Int @map("estimated_days_max")
  isEnabled Boolean @default(false) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  carts Cart[]
  orders Order[]
  @@index([isEnabled, countryCode, currencyCode])
  @@map("shipping_methods")
}
